{
  "name": "book-vector",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A neumorphic 3D globe where every book is a raised clay bump on a pale sphere.",
  "scripts": {
    "data:sample": "node scripts/generate-sample.mjs",
    "data:atlas": "node scripts/build-data.mjs",
    "predev": "node scripts/build-data.mjs --if-missing && node scripts/fetch-fonts.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-data.mjs && node scripts/fetch-fonts.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "fonts": "node scripts/fetch-fonts.mjs",
    "pipeline:check": "python3 -m py_compile pipeline/*.py",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "minisearch": "^7.1.0",
    "motion": "^14.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
